{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDP environment definition",
  "description": "Non-secret values for one environment. Secrets never appear here: local ones are generated into local/.env.<env>, Azure ones come from Key Vault.",
  "type": "object",
  "additionalProperties": false,
  "required": ["env", "target", "region", "storage", "telemetry"],
  "properties": {
    "env": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,7}$", "description": "Suffix for every resource name: sdp-<env>, <svc>-<env>, st<role><env>" },
    "target": { "enum": ["compose", "k3s", "azure"] },
    "region": { "type": "string", "pattern": "^[a-z0-9]+$", "description": "Azure region name, or 'local'" },
    "ports": {
      "type": "object", "additionalProperties": false,
      "required": ["postgres", "blob", "grafana", "otlp_grpc", "otlp_http"],
      "properties": {
        "postgres": { "$ref": "#/$defs/port" }, "blob": { "$ref": "#/$defs/port" },
        "grafana": { "$ref": "#/$defs/port" }, "otlp_grpc": { "$ref": "#/$defs/port" },
        "otlp_http": { "$ref": "#/$defs/port" }, "clamav": { "$ref": "#/$defs/port" },
        "keyvault": { "$ref": "#/$defs/port" }
      }
    },
    "k3s": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "kube_context", "namespace", "platform_namespace"],
      "properties": {
        "host": { "type": "string", "format": "ipv4" },
        "kube_context": { "type": "string" },
        "namespace": { "type": "string" },
        "platform_namespace": { "type": "string" }
      }
    },
    "postgres": {
      "type": "object", "additionalProperties": false, "required": ["db", "admin_user"],
      "properties": { "db": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" }, "admin_user": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" } }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["accounts"],
      "properties": {
        "accounts": {
          "type": "object", "additionalProperties": false,
          "required": ["landing", "clientip", "records", "platform"],
          "patternProperties": { "": { "$ref": "#/$defs/account" } },
          "properties": { "landing": {}, "clientip": {}, "records": {}, "platform": {} }
        }
      }
    },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$", "description": "Owner tag value (a handle, never an email)" },
    "naming": {
      "type": "object", "additionalProperties": false, "required": ["client", "project", "instance", "stage"],
      "description": "Azure names: <client>-<project>-<type>-<instance>-<stage> (newco-sdp-kv-1-dev); storage accounts drop the hyphens and use the account's short role (newcosdplnd1dev)",
      "properties": {
        "client": { "type": "string", "pattern": "^[a-z]{2,8}$" }, "project": { "type": "string", "pattern": "^[a-z]{2,5}$" },
        "instance": { "type": "integer", "minimum": 1, "maximum": 9 }, "stage": { "type": "string", "pattern": "^[a-z]{2,5}$" }
      }
    },
    "azure": {
      "type": "object", "additionalProperties": false,
      "required": ["subscription_id", "tenant_id", "terraform_client_id", "terraform_certificate_path"],
      "description": "Identifiers only; the certificate password comes from the workstation keychain",
      "properties": {
        "subscription_id": { "$ref": "#/$defs/uuid" }, "tenant_id": { "$ref": "#/$defs/uuid" },
        "terraform_client_id": { "$ref": "#/$defs/uuid" }, "terraform_certificate_path": { "type": "string" },
        "workload_client_id": { "$ref": "#/$defs/uuid" },
        "workload_principal_id": { "$ref": "#/$defs/uuid", "description": "Service principal object ID that gets the data roles" },
        "purge_client_id": { "$ref": "#/$defs/uuid", "description": "Purge worker's app (client) ID; core azdev-env.sh signs it in with its own certificate (TD-14)" },
        "purge_certificate_path": { "type": "string", "description": "Purge worker's .pfx; default ~/.azure/certs/sp-sdp-purge-dev.pfx" },
        "purge_principal_id": { "$ref": "#/$defs/uuid", "description": "Purge worker's own principal object ID (core TD-14): Blob Data Owner and Scope Writer on tenant accounts, Crypto User on the vault" },
        "portal_origins": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "Browser origins allowed to PUT to the landing account (CORS)" }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["address_space", "pe_subnet", "router_subnet", "admin_ssh_public_key_path"],
      "properties": {
        "address_space": { "$ref": "#/$defs/cidr" }, "pe_subnet": { "$ref": "#/$defs/cidr" },
        "router_subnet": { "$ref": "#/$defs/cidr" }, "admin_ssh_public_key_path": { "type": "string" }
      }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false, "required": ["otlp_endpoint", "operational_log_days"],
      "properties": {
        "otlp_endpoint": { "type": "string", "format": "uri" },
        "operational_log_days": { "type": "integer", "minimum": 1, "maximum": 730 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "target": { "const": "compose" } } }, "then": { "required": ["ports", "postgres"] } },
    { "if": { "properties": { "target": { "const": "k3s" } } }, "then": { "required": ["k3s"] } },
    { "if": { "properties": { "target": { "const": "azure" } } }, "then": { "required": ["naming", "azure", "network", "owner"] } }
  ],
  "$defs": {
    "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "account": {
      "type": "object", "additionalProperties": false, "required": ["prefix", "holds"],
      "properties": {
        "prefix": { "type": "string", "pattern": "^st[a-z]{2,6}$" }, "holds": { "type": "string" },
        "short": { "type": "string", "pattern": "^[a-z]{2,4}$", "description": "Role in Azure storage account names" }
      }
    }
  }
}
