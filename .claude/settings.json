{
  "permissions": {
    "ask": [
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.git/hooks/**)",
      "Write(.git/hooks/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.local)",
      "Read(**/.env.prod*)",
      "Edit(**/.env.prod*)",
      "Write(**/.env.prod*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/kubeconfig*)",
      "Read(~/.kube/**)",
      "Read(~/.azure/**)",
      "Edit(**/prod/**)",
      "Write(**/prod/**)",
      "Edit(**/production/**)",
      "Write(**/production/**)",
      "Edit(**/values-prod*.yaml)",
      "Write(**/values-prod*.yaml)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm install:*)",
      "Bash(helm uninstall:*)",
      "Bash(az keyvault secret show:*)",
      "Bash(az keyvault secret download:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/.terraform/**)"
    ]
  }
}
