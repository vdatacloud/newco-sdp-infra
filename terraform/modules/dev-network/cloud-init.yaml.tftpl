#cloud-config
package_update: true
packages: [dnsmasq]
write_files:
  - path: /etc/sysctl.d/99-tailscale.conf
    content: |
      net.ipv4.ip_forward = 1
      net.ipv6.conf.all.forwarding = 1
  - path: /etc/dnsmasq.d/azure.conf
    content: |
      # Tailnet split DNS (blob.core.windows.net, vault.azure.net) lands here and goes to Azure's resolver,
      # which answers with the private endpoint addresses.
      listen-address=${listen_ip}
      bind-interfaces
      no-resolv
      server=${azure_dns}
runcmd:
  - sysctl --system
  - systemctl restart dnsmasq
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key='${auth_key}' --hostname='${hostname}' --advertise-routes='${routes}' --accept-dns=false --ssh
